# Copy to .env for local reference. NOT auto-loaded (no python-dotenv
# dependency) — export these in your shell, or pass inline, e.g.:
#   JWT_SECRET_KEY=dev-secret python -m uvicorn app.main:app

# Required in any real deployment; a warned-about insecure dev default is
# used if unset locally. Render's render.yaml auto-generates this on deploy.
JWT_SECRET_KEY=change-me-to-a-random-string

# SQLite by default. Point at Postgres for real persistence:
#   DATABASE_URL=postgresql+psycopg://user:pass@host/dbname
DATABASE_URL=sqlite:///./watchlist.db

# Background poller (§07). Set to 0 to disable entirely (e.g. if you only
# want the manual /api/dev/populate/{symbol} trigger during development).
SCHEDULER_ENABLED=1
POLL_INTERVAL_MINUTES=10

# Dev-only pipeline-trigger endpoints. Set to 0 to hide them in a real deploy.
DEV_ROUTES=1

# Optional — enables real AI narration of significant events (§11 boundary
# rule: only ever explains an already-confirmed move, never decides one).
# Without this set, POST /api/stocks/{symbol}/events/{id}/narrate still
# works and still cites a real news headline via yfinance — it just skips
# LLM synthesis and says so plainly (generated_by: "headline-fallback").
ANTHROPIC_API_KEY=
ANTHROPIC_NARRATOR_MODEL=claude-haiku-4-5-20251001
